DATABASE_URL=postgresql://username:password@hostname/database?sslmode=require
SQLITE_DATABASE_PATH=./literacy_platform.db
JWT_SECRET_KEY=replace-with-secure-secret
BACKEND_CORS_ORIGINS=https://your-frontend.example
GEMINI_API_KEY=replace-with-your-key
GEMINI_COURSE_PLAN_MODEL=gemini-3.5-flash
GEMINI_LESSON_PRIMARY_MODEL=gemini-3.5-flash
GEMINI_LESSON_FALLBACK_MODEL=gemini-3.5-flash-lite

# DATABASE_URL takes precedence over SQLITE_DATABASE_PATH.
# Leave DATABASE_URL unset for local SQLite fallback.
# Neon PostgreSQL requires SSL, usually sslmode=require.
# Never commit real database URLs, JWT secrets, or Gemini keys.
